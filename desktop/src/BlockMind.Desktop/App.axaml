<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <!-- Linear Design System - Dark Theme -->
        <SolidColorBrush x:Key="BgBase" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="BgSurface" Color="#111111"/>
        <SolidColorBrush x:Key="BgHover" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BgActive" Color="#222222"/>
        <SolidColorBrush x:Key="Border" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2A2A2A"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#EDEDED"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#555555"/>

        <SolidColorBrush x:Key="Accent" Color="#7C5CFC"/>
        <SolidColorBrush x:Key="AccentHover" Color="#9B7FFF"/>
        <SolidColorBrush x:Key="Success" Color="#00D68F"/>
        <SolidColorBrush x:Key="Warning" Color="#FFAA00"/>
        <SolidColorBrush x:Key="Error" Color="#FF3B3B"/>
        <SolidColorBrush x:Key="Info" Color="#3B82F6"/>

        <SolidColorBrush x:Key="HealthFull" Color="#00D68F"/>
        <SolidColorBrush x:Key="HealthMid" Color="#FFAA00"/>
        <SolidColorBrush x:Key="HealthLow" Color="#FF3B3B"/>

        <x:Double x:Key="SpaceXs">4</x:Double>
        <x:Double x:Key="SpaceSm">8</x:Double>
        <x:Double x:Key="SpaceMd">12</x:Double>
        <x:Double x:Key="SpaceLg">16</x:Double>
        <x:Double x:Key="SpaceXl">24</x:Double>
        <x:Double x:Key="Space2xl">32</x:Double>

        <CornerRadius x:Key="RadiusSm">4</CornerRadius>
        <CornerRadius x:Key="RadiusMd">6</CornerRadius>
        <CornerRadius x:Key="RadiusLg">8</CornerRadius>
        <CornerRadius x:Key="RadiusFull">999</CornerRadius>
    </Application.Resources>
</Application>
