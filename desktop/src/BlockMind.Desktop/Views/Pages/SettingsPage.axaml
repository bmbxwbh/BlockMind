<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.SettingsPage">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="#EDEDED"/>
            <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Minecraft" FontSize="14" FontWeight="SemiBold" Foreground="#EDEDED"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Version:" Width="100" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding McVersion}" Width="150" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Max RAM:" Width="100" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding MaxRam}" Width="100" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Dynmap" FontSize="14" FontWeight="SemiBold" Foreground="#EDEDED"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Enabled:" Width="100" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBlock Text="{Binding DynmapEnabled}" VerticalAlignment="Center" Foreground="#EDEDED"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Port:" Width="100" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding DynmapPort}" Width="100" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Button Content="Save" Command="{Binding SaveSettingsCommand}" Padding="20,8" Background="#7C5CFC" Foreground="#FFFFFF" BorderBrush="#7C5CFC"/>
                <Button Content="Reset" Command="{Binding ResetSettingsCommand}" Padding="20,8" Margin="8,0,0,0" Background="#222222" Foreground="#FF3B3B" BorderBrush="#1F1F1F"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
