<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.ModelConfigPage">
    <ScrollViewer Padding="32" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
            <TextBlock Text="模型配置" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>

            <Border Background="#161616" CornerRadius="14" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="主 Agent（聊天）" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="格式" Width="70" VerticalAlignment="Center" Foreground="#888888" FontSize="13"/>
                        <TextBox Text="{Binding MainFormat}" Width="200" Background="#1E1E1E" Foreground="#EDEDED" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="地址" Width="70" VerticalAlignment="Center" Foreground="#888888" FontSize="13"/>
                        <TextBox Text="{Binding MainBaseUrl}" Width="420" Background="#1E1E1E" Foreground="#EDEDED" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="密钥" Width="70" VerticalAlignment="Center" Foreground="#888888" FontSize="13"/>
                        <TextBox Text="{Binding MainApiKey}" Width="420" PasswordChar="*" Background="#1E1E1E" Foreground="#EDEDED" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="模型" Width="70" VerticalAlignment="Center" Foreground="#888888" FontSize="13"/>
                        <TextBox Text="{Binding MainModel}" Width="200" Background="#1E1E1E" Foreground="#EDEDED" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="测试连接" Command="{Binding TestMainConnectionCommand}" Padding="16,8" CornerRadius="10" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#2A2A2A" BorderThickness="1"/>
                        <TextBlock Text="{Binding MainTestStatus}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#00D68F" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#161616" CornerRadius="14" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="操作 Agent（执行）" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="格式" Width="70" VerticalAlignment="Center" Foreground="#888888" FontSize="13"/>
                        <TextBox Text="{Binding OpFormat}" Width="200" Background="#1E1E1E" Foreground="#EDEDED" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="地址" Width="70" VerticalAlignment="Center" Foreground="#888888" FontSize="13"/>
                        <TextBox Text="{Binding OpBaseUrl}" Width="420" Background="#1E1E1E" Foreground="#EDEDED" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="密钥" Width="70" VerticalAlignment="Center" Foreground="#888888" FontSize="13"/>
                        <TextBox Text="{Binding OpApiKey}" Width="420" PasswordChar="*" Background="#1E1E1E" Foreground="#EDEDED" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="模型" Width="70" VerticalAlignment="Center" Foreground="#888888" FontSize="13"/>
                        <TextBox Text="{Binding OpModel}" Width="200" Background="#1E1E1E" Foreground="#EDEDED" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="测试连接" Command="{Binding TestOpConnectionCommand}" Padding="16,8" CornerRadius="10" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#2A2A2A" BorderThickness="1"/>
                        <TextBlock Text="{Binding OpTestStatus}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#00D68F" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="保存配置" Command="{Binding SaveConfigCommand}" Padding="24,10" CornerRadius="10" Background="#7C5CFC" Foreground="#FFFFFF" BorderThickness="0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
