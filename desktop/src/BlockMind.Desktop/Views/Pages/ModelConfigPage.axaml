<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.ModelConfigPage">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock Text="模型配置" FontSize="24" FontWeight="SemiBold" Foreground="#EDEDED"/>

            <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="主 Agent（聊天）" FontSize="14" FontWeight="SemiBold" Foreground="#EDEDED"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="格式：" Width="80" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding MainFormat}" Width="200" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="地址：" Width="80" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding MainBaseUrl}" Width="400" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="密钥：" Width="80" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding MainApiKey}" Width="400" PasswordChar="*" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="模型：" Width="80" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding MainModel}" Width="200" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="温度：" Width="80" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBlock Text="{Binding MainTemperature, StringFormat='{}{0:F1}'}" Width="40" Foreground="#EDEDED"/>
                        <Slider Value="{Binding MainTemperature}" Minimum="0" Maximum="2" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="测试连接" Command="{Binding TestMainConnectionCommand}" Padding="12,6" Background="#222222" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                        <TextBlock Text="{Binding MainTestStatus}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#00D68F"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="操作 Agent（执行）" FontSize="14" FontWeight="SemiBold" Foreground="#EDEDED"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="格式：" Width="80" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding OpFormat}" Width="200" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="地址：" Width="80" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding OpBaseUrl}" Width="400" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="密钥：" Width="80" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding OpApiKey}" Width="400" PasswordChar="*" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="模型：" Width="80" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBox Text="{Binding OpModel}" Width="200" Background="#1A1A1A" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="温度：" Width="80" VerticalAlignment="Center" Foreground="#888888"/>
                        <TextBlock Text="{Binding OpTemperature, StringFormat='{}{0:F1}'}" Width="40" Foreground="#EDEDED"/>
                        <Slider Value="{Binding OpTemperature}" Minimum="0" Maximum="2" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="测试连接" Command="{Binding TestOpConnectionCommand}" Padding="12,6" Background="#222222" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                        <TextBlock Text="{Binding OpTestStatus}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#00D68F"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="保存配置" Command="{Binding SaveConfigCommand}" Padding="20,8" Background="#7C5CFC" Foreground="#FFFFFF" BorderBrush="#7C5CFC"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
