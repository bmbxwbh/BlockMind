<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.MarketplacePage">
    <Border Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Marketplace" FontSize="24" FontWeight="SemiBold" Foreground="#EDEDED"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" Padding="12,6" Margin="8,0,0,0" Background="#222222" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                <TextBox Text="{Binding SearchQuery}" Watermark="Search skills..." Background="#111111" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
            </DockPanel>
            <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,2" CornerRadius="6" Background="#111111">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#EDEDED"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#888888" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Rating, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="#555555" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Install" Padding="12,6" VerticalAlignment="Center" Background="#7C5CFC" Foreground="#FFFFFF" BorderBrush="#7C5CFC"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
