<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.MarketplacePage">
    <Border Padding="32">
        <StackPanel Spacing="20">
            <TextBlock Text="技能市场" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="搜索" Command="{Binding SearchCommand}" Padding="16,8" Margin="10,0,0,0" CornerRadius="10" Background="#7C5CFC" Foreground="#FFFFFF" BorderThickness="0"/>
                <TextBox Text="{Binding SearchQuery}" Watermark="搜索技能..." Background="#161616" Foreground="#EDEDED" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="12,10"/>
            </DockPanel>
            <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,12" Margin="0,2" CornerRadius="12" Background="#161616">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="安装" Padding="16,8" CornerRadius="10" VerticalAlignment="Center" Background="#7C5CFC" Foreground="#FFFFFF" BorderThickness="0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
