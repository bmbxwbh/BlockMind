<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.SafetyPage">
    <Border Padding="32">
        <StackPanel Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="安全设置" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Content="加载审计日志" Command="{Binding LoadAuditLogCommand}" Padding="16,8" CornerRadius="10" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#2A2A2A" BorderThickness="1"/>
            </StackPanel>
            <Border Background="#161616" CornerRadius="14" Padding="16">
                <ListBox ItemsSource="{Binding AuditLog}" Background="Transparent" BorderThickness="0" MaxHeight="400">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13" Foreground="#888888" Margin="0,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
