<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.ChatPage">
    <DockPanel LastChildFill="True" Margin="32,32,32,24">
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Messages}" Background="Transparent"
                 BorderThickness="0" VerticalAlignment="Stretch" Margin="0,0,0,16">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14,10" CornerRadius="12" Margin="0,3" Background="#161616">
                        <StackPanel>
                            <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold" Foreground="#7C5CFC"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,0" Foreground="#EDEDED"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel DockPanel.Dock="Bottom">
            <Button DockPanel.Dock="Right" Content="发送" Command="{Binding SendCommand}" Padding="20,10" Margin="10,0,0,0" CornerRadius="10" Background="#7C5CFC" Foreground="#FFFFFF" BorderThickness="0"/>
            <TextBox Text="{Binding InputText}" Watermark="输入消息..." IsEnabled="{Binding !IsBusy}" Background="#161616" Foreground="#EDEDED" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="14,10"/>
        </DockPanel>
    </DockPanel>
</UserControl>
