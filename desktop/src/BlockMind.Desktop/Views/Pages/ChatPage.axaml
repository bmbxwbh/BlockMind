<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.ChatPage">
    <DockPanel LastChildFill="True" Margin="24">
        <!-- Messages -->
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Messages}" Background="Transparent"
                 BorderThickness="0" VerticalAlignment="Stretch" Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,6" CornerRadius="6" Margin="0,2" Background="{DynamicResource BgSurface}">
                        <StackPanel>
                            <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Input -->
        <DockPanel DockPanel.Dock="Bottom">
            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" Padding="16,8" Margin="8,0,0,0"/>
            <TextBox Text="{Binding InputText}" Watermark="Type a message..." IsEnabled="{Binding !IsBusy}"/>
        </DockPanel>
    </DockPanel>
</UserControl>
