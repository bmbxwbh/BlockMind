<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.ChatPage">
    <DockPanel LastChildFill="True" Margin="24">
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Messages}" Background="Transparent"
                 BorderThickness="0" VerticalAlignment="Stretch" Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8" CornerRadius="6" Margin="0,2" Background="#111111">
                        <StackPanel>
                            <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold" Foreground="#7C5CFC"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0" Foreground="#EDEDED"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel DockPanel.Dock="Bottom">
            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" Padding="16,8" Margin="8,0,0,0" Background="#222222" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
            <TextBox Text="{Binding InputText}" Watermark="Type a message..." IsEnabled="{Binding !IsBusy}" Background="#111111" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
        </DockPanel>
    </DockPanel>
</UserControl>
