<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.MapPage">
    <Border Padding="32">
        <StackPanel Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="地图" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Content="检查 Dynmap" Command="{Binding CheckDynmapCommand}" Padding="16,8" CornerRadius="10" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#2A2A2A" BorderThickness="1"/>
            </StackPanel>
            <Border Background="#161616" CornerRadius="14" Padding="40" MinHeight="300">
                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Dynmap 地图视图" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding DynmapUrl}" FontSize="13" Foreground="#888888" HorizontalAlignment="Center"/>
                    <TextBlock Text="需安装 Dynmap 插件后启用" FontSize="12" Foreground="#555555" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
