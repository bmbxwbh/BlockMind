<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.MemoryPage">
    <Border Padding="32">
        <StackPanel Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="记忆系统" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Content="加载" Command="{Binding LoadMemoryCommand}" Padding="16,8" CornerRadius="10" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#2A2A2A" BorderThickness="1"/>
                <Button Content="备份" Command="{Binding BackupMemoryCommand}" Padding="16,8" CornerRadius="10" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#2A2A2A" BorderThickness="1"/>
                <Button Content="清理" Command="{Binding CleanupMemoryCommand}" Padding="16,8" CornerRadius="10" Background="#1E1E1E" Foreground="#FF3B3B" BorderBrush="#2A2A2A" BorderThickness="1"/>
            </StackPanel>
            <WrapPanel>
                <Border Background="#161616" CornerRadius="14" Padding="20,16" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="区域" FontSize="12" Foreground="#666666"/>
                        <TextBlock Text="{Binding ZoneCount}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#161616" CornerRadius="14" Padding="20,16" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="路径" FontSize="12" Foreground="#666666"/>
                        <TextBlock Text="{Binding PathCount}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#161616" CornerRadius="14" Padding="20,16" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="策略" FontSize="12" Foreground="#666666"/>
                        <TextBlock Text="{Binding StrategyCount}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#161616" CornerRadius="14" Padding="20,16" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="玩家" FontSize="12" Foreground="#666666"/>
                        <TextBlock Text="{Binding PlayerCount}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
