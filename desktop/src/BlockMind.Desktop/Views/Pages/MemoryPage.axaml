<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.MemoryPage">
    <Border Padding="24">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Memory" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#EDEDED"/>
                <Button Content="Load" Command="{Binding LoadMemoryCommand}" Padding="12,6" Margin="16,0,0,0" Background="#222222" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                <Button Content="Backup" Command="{Binding BackupMemoryCommand}" Padding="12,6" Margin="8,0,0,0" Background="#222222" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
                <Button Content="Cleanup" Command="{Binding CleanupMemoryCommand}" Padding="12,6" Margin="8,0,0,0" Background="#222222" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
            </StackPanel>
            <WrapPanel>
                <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16" Width="200" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Zones" FontSize="12" Foreground="#888888"/>
                        <TextBlock Text="{Binding ZoneCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="#EDEDED"/>
                    </StackPanel>
                </Border>
                <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16" Width="200" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Paths" FontSize="12" Foreground="#888888"/>
                        <TextBlock Text="{Binding PathCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="#EDEDED"/>
                    </StackPanel>
                </Border>
                <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16" Width="200" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Strategies" FontSize="12" Foreground="#888888"/>
                        <TextBlock Text="{Binding StrategyCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="#EDEDED"/>
                    </StackPanel>
                </Border>
                <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16" Width="200" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Players" FontSize="12" Foreground="#888888"/>
                        <TextBlock Text="{Binding PlayerCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="#EDEDED"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
