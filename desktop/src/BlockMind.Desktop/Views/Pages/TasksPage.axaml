<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.TasksPage">
    <Border Padding="24">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="任务队列" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#EDEDED"/>
                <Button Content="刷新" Command="{Binding LoadTasksCommand}" Padding="12,6" Margin="16,0,0,0" Background="#222222" Foreground="#EDEDED" BorderBrush="#1F1F1F"/>
            </StackPanel>
            <WrapPanel>
                <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16" Width="200" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="待执行" FontSize="12" Foreground="#888888"/>
                        <TextBlock Text="{Binding PendingCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="#EDEDED"/>
                    </StackPanel>
                </Border>
                <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16" Width="200" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="运行中" FontSize="12" Foreground="#888888"/>
                        <TextBlock Text="{Binding RunningCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="#EDEDED"/>
                    </StackPanel>
                </Border>
                <Border Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="16" Width="200" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="已完成" FontSize="12" Foreground="#888888"/>
                        <TextBlock Text="{Binding CompletedCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="#EDEDED"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
