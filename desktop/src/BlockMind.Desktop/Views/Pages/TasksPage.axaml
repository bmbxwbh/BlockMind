<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.TasksPage">
    <Border Padding="32">
        <StackPanel Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="任务队列" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Content="刷新" Command="{Binding LoadTasksCommand}" Padding="16,8" CornerRadius="10" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#2A2A2A" BorderThickness="1"/>
            </StackPanel>
            <WrapPanel>
                <Border Background="#161616" CornerRadius="14" Padding="20,16" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="待执行" FontSize="12" Foreground="#666666"/>
                        <TextBlock Text="{Binding PendingCount}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#161616" CornerRadius="14" Padding="20,16" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="运行中" FontSize="12" Foreground="#666666"/>
                        <TextBlock Text="{Binding RunningCount}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#161616" CornerRadius="14" Padding="20,16" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="已完成" FontSize="12" Foreground="#666666"/>
                        <TextBlock Text="{Binding CompletedCount}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
