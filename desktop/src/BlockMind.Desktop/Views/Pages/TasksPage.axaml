<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockMind.Desktop.Views.Pages.TasksPage">
    <Border Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Tasks" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Coming soon..." FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
    </Border>
</UserControl>
